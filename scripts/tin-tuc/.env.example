# Bí mật của bot bản tin — chép file này thành `.env` CẠNH NÓ rồi điền:
#
#     cp scripts/tin-tuc/.env.example scripts/tin-tuc/.env
#
# `.env` khớp mẫu đã có trong `.gitignore` ở gốc repo (dòng `.env`, không có dấu `/` nên
# nó khớp ở MỌI tầng thư mục) ⇒ file thật không đi vào git. Không phải sửa `.gitignore`,
# và **đừng** thêm ngoại lệ nào cho nó.
#
# Biến môi trường thật THẮNG file này, và `--origin` của CLI thắng cả hai — xem
# `docCauHinh` trong `lib.mjs`. Nhờ vậy chạy tay một lượt vào máy dev không cần sửa file.

# Gốc của site. Prod là https://gikky.net; máy dev là http://localhost:8000.
GIKKY_ORIGIN=https://gikky.net

# Tài khoản đăng bài, dựng sẵn bởi `python manage.py tao_tai_khoan_doi`.
# ⚠ Đăng nhập bằng EMAIL, không phải username — `ACCOUNT_LOGIN_METHODS = {"email"}`
#   (`api/config/settings.py`). Điền sai chỗ này thì lỗi trả về là "sai mật khẩu".
GIKKY_BOT_EMAIL=gikky-team-news@vi-du.gikky.net

# ⚠⚠ Mật khẩu của tài khoản trên **Ở MÔI TRƯỜNG MÀ `GIKKY_ORIGIN` TRỎ TỚI**.
#
# Trỏ prod thì đây là mật khẩu PROD — KHÔNG phải giá trị `GIKKY_TEAM_NEWS_PASSWORD`
# trong `api/.env` của máy dev. Hai máy có hai DB khác nhau; chép nhầm thì triệu chứng
# là "sai mật khẩu" ở 06:12 sáng, và không ai ngồi đó đọc nó.
#
# Lấy mật khẩu prod ở `api/.env` TRÊN VPS (biến `GIKKY_TEAM_NEWS_PASSWORD`).
GIKKY_BOT_PASSWORD=

# --- Hai biến dưới đây CHỈ dành cho bài đo, đừng đặt trong file thật ------------
#
# GIKKY_BOT_SO_CAI     — trỏ sổ cái `da-dang.json` sang chỗ khác.
# GIKKY_BOT_ENV_FILE   — trỏ chính file này sang chỗ khác.
# GIKKY_BOT_GIO_GIA_LAP— tiêm "bây giờ" dạng ISO, để dựng ca "task fire trễ".
