# Chép thành `api/.env` rồi sửa: `pnpm setup:env` ở gốc repo làm đúng việc đó
# (không đè nếu `.env` đã có). File `.env` KHÔNG commit.

# `pnpm setup:env` THAY dòng dưới bằng một khoá ngẫu nhiên khi tạo `api/.env` — giá trị
# viết ở đây chỉ là chỗ giữ chỗ và KHÔNG BAO GIỜ được chạy trên máy nào: nó nằm trong repo,
# ai cũng đọc được, mà từ Phase 2 nó là khoá ký session cookie (giả mạo phiên được).
# Chép tay (không qua setup:env) thì tự sinh khoá:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=doi-chuoi-nay-o-moi-may-va-o-prod

# CHỈ CHO DEV. Lên prod phải là False: DEBUG=True in traceback kèm cấu hình ra trang lỗi,
# và nó cũng là công tắc mở `/api/v1/docs` + `/api/v1/openapi.json` (xem api/api/v1.py).
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Host được phép chạm `/api/admin/*` — hàng rào tầng hạ tầng của PLAN 8.2, mô phỏng bằng
# middleware `config/host_admin.py`. Bỏ trống dòng này để dùng mặc định của dev (xem
# `config/settings.py`); trên prod đặt đúng MỘT host: ADMIN_HOSTS=admin.gikky.net
#
# ⚠ Ở DEV nó KHÔNG tách được app admin (3001) khỏi app public (3000): cả hai rewrite
# `/api/*` sang cùng một origin nên Django thấy cùng một Host. Lớp che thật ở dev là
# permission `is_staff`. Đọc docstring `config/host_admin.py` trước khi tin dòng này.
#ADMIN_HOSTS=admin.gikky.net
#
# Cookie/CSRF cross-subdomain mà khu quản trị cũng cần nằm ở khối "CSRF / cookie" CUỐI
# file — khai đúng một lần. Thêm một dòng `SESSION_COOKIE_DOMAIN=` thứ hai ở đây thì
# django-environ đọc file từ trên xuống và **dòng dưới thắng**, im lặng.

# Máy dev hiện tại: PostgreSQL 17 LOCAL ở cổng 5432 (không dùng Docker).
# Nếu chạy docker-compose.dev.yml thì đổi cổng sang 55432 — xem docker-compose.dev.yml.
#
# `setup:env` KHÔNG sinh mật khẩu hộ (khác `SECRET_KEY`) — nó không biết bạn đã tạo role
# `gikky` bằng mật khẩu gì. Sửa tay dòng dưới cho khớp `CREATE ROLE gikky LOGIN PASSWORD …`.
# File này nằm trong repo công khai ⇒ KHÔNG được mang một mật khẩu thật của bất kỳ máy nào.
DATABASE_URL=postgres://gikky:doi-mat-khau-nay@127.0.0.1:5432/gikky_dev

# --- Tài khoản (Phase 2) -----------------------------------------------------
# Gốc của frontend Next công khai. Link trong email xác thực / đặt lại mật khẩu trỏ về
# đây, và nó PHẢI tuyệt đối: request tới Django ở dev đi qua rewrites của Next nên Host
# của nó là localhost:8000 — link tương đối sẽ ra đúng cổng Django và người bấm nhận 404.
#
# Cũng là origin mà digest tuần của Phase 6 dựng link (`gui_digest.py::goc_site`), nên nó
# phải KHỚP biến `SITE_ORIGIN` của `apps/web` (`apps/web/lib/site.ts`). Hai tên cho một
# giá trị là dấu vết của hai mảng làm song song; lượt gộp 2026-08-23 giữ tên này ở phía
# Django và không khai `SITE_ORIGIN` thứ hai.
FRONTEND_ORIGIN=http://localhost:3000

# Google OAuth: KHÔNG có credential thì provider không được đăng ký và frontend KHÔNG
# render nút (PLAN mục 4 — cấm nút vĩnh viễn không bấm được). Để trống là trạng thái
# đúng của máy dev.
# Redirect URI phải đăng ký với Google — CHUỖI DƯỚI ĐÂY, có dấu `/` cuối:
#   https://gikky.net/api/_allauth/google/login/callback/
#   http://localhost:3000/api/_allauth/google/login/callback/   (nếu muốn thử ở máy dev)
#
# ⚠ Dòng này TỪNG GHI SAI `.../browser/v1/auth/provider/callback` (sửa 2026-08-27 sau khi
# prod ăn `Error 400: redirect_uri_mismatch`). Hai đường khác vai và dễ lẫn:
#   - `/_allauth/browser/v1/auth/provider/redirect` là nơi FRONTEND POST vào để bắt đầu;
#   - `/_allauth/google/login/callback/` là nơi GOOGLE gọi ngược lại, do
#     `GoogleOAuth2Adapter.get_callback_url()` sinh ra. Chỉ chuỗi thứ hai đi vào
#     `redirect_uri`, và chỉ nó phải đăng ký.
# Cách tự kiểm khi nghi ngờ: bấm nút Google, đọc tham số `redirect_uri=` trong URL trang
# lỗi của Google — đó là chuỗi app THẬT SỰ gửi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Bỏ trống => ghi ra file `api/.mail/` (dev, không cần SMTP). Prod đặt SMTP:
#   EMAIL_URL=smtp+ssl://<user>:<mat-khau>@smtp.vi-du.com:465   ← TLS NGẦM, cổng 465
#   EMAIL_URL=smtps://<user>:<mat-khau>@smtp.vi-du.com:587      ← STARTTLS, cổng 587
#
# ⚠ **SCHEME quyết định mã hoá, KHÔNG phải query param.** Dạng `smtp://…?tls=True` là thứ
# ai cũng gõ theo phản xạ, và nó **BỊ BỎ QUA HOÀN TOÀN** — django-environ đọc TLS/SSL từ
# scheme (`environ/environ.py:879-892`); `?tls=True` rơi vào `config["OPTIONS"]`, mà backend
# SMTP của Django không đọc `OPTIONS`. Hậu quả: nối SMTP **không mã hoá**, đẩy user/mật khẩu
# SMTP dạng thô lên đường truyền, và **không một dòng cảnh báo nào**.
#
# Đo thật với chính `django-environ` trong `api/.venv` (nợ `P-20260827-3`):
#     smtp://u:p@h:587/?tls=True  ->  EMAIL_USE_TLS=None   EMAIL_USE_SSL=None   ← hỏng
#     smtps://u:p@h:587           ->  EMAIL_USE_TLS=True                        ← STARTTLS
#     smtp+ssl://u:p@h:465        ->                       EMAIL_USE_SSL=True   ← TLS ngầm
EMAIL_URL=
DEFAULT_FROM_EMAIL=gikky <no-reply@gikky.net>

# CSRF / cookie (PLAN 8.2). Bỏ trống => mặc định 4 origin dev (localhost + 127.0.0.1,
# cổng 3000 và 3001). Prod:
#   CSRF_TRUSTED_ORIGINS=https://gikky.net,https://admin.gikky.net
#   SESSION_COOKIE_DOMAIN=.gikky.net
#   CSRF_COOKIE_DOMAIN=.gikky.net
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# --- On-demand revalidate (Phase 3, PLAN 8.4 điểm 3) -------------------------
# Django gọi ngược Next để làm mới trang mạch đã cache khi có sự kiện CÓ signal (mốc
# mới, trích, đóng/mở/khoá mạch). Cơ chế: `api/core/revalidate.py`.
#
# **Bỏ trống `REVALIDATE_SECRET` là TẮT HẲN, và đó là mặc định đúng ở máy dev**: một lời
# gọi HTTP ra localhost:3000 giữa lúc chạy `pnpm test` sẽ hoặc treo tới timeout, hoặc đập
# vào app Next của người khác đang chạy.
#
# ⚠ **`pnpm setup:env` SINH sẵn một chuỗi ngẫu nhiên vào dòng dưới** (L07, vá V1
# 2026-08-23) — trước đó nó ra `.env` ở dạng RỖNG, và rỗng nghĩa là cửa tắt hẳn. Hai hậu
# quả, cả hai im lặng: (1) ở dev không sự kiện CÓ signal nào làm mới cache, trang khách
# đứng nguyên tới một giờ; (2) `apps/web/e2e/du-lieu.ts` **ném** khi secret rỗng, ở
# `beforeAll` của ba file spec ⇒ một máy vừa clone chạy `pnpm e2e` ăn ≥42 bài đỏ.
#
# Hai tiến trình phải cùng chuỗi: Django đọc dòng này; tiến trình Next nhận nó qua
# `scripts/web-dev.mjs` (dev) và `playwright.config.ts` (e2e) — cả hai đọc CHÍNH file này,
# nên không có bản sao nào để lệch. Lệch nhau thì cửa nhận trả 401 và cache lặng lẽ không
# bao giờ được làm mới.
# Sinh tay: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
REVALIDATE_SECRET=

# --- Hạn mức chống lạm dụng (PLAN mục 10 Phase 6 + 5.10) ---------------------
# Mặc định trong `config/settings.py` là **con số của PLAN** — tức con số chạy trên prod,
# nơi không ai khai mấy biến này. Ba dòng dưới **nới cho máy dev**, và đó là lý do chúng
# nằm ở đây chứ không ở settings:
#
#   - bộ e2e đăng ký **14 tài khoản mỗi lần chạy**, tất cả từ `127.0.0.1`. Với con số thật
#     của PLAN (5/IP/ngày) thì lượt chạy đầu tiên đã chết ở tài khoản thứ sáu — và nó chết
#     ở `beforeAll`, tức đỏ hàng loạt vì một hành vi ĐÚNG;
#   - hạn mức thật vẫn được đo, chỉ không đo ở đây: `api/tests/test_han_muc.py` hạ trần
#     xuống 1–2 bằng `override_settings` rồi đo cả hai chiều (vượt ⇒ 429/403, dưới ⇒ qua),
#     và nó ghim luôn ranh giới nửa đêm giờ VN.
#
# **Trên prod: XOÁ hoặc để trống ba dòng này** để dùng mặc định của PLAN.
HAN_MUC_DANG_KY_MOI_IP_NGAY=1000
HAN_MUC_MACH_MOI_USER_NGAY=200
HAN_MUC_BINH_LUAN_MOI_GIO_TAI_KHOAN_MOI=200

# Có tin header `X-Forwarded-For` không — quyết định hạn mức theo IP đếm theo gì.
#
# **Dev: False** (không có proxy nào phía trước Django; tin header ấy là để bất kỳ ai tự
# khai IP của mình bằng một dòng, tức hạn mức bốc hơi).
# **Prod: PHẢI là True.** Django ngồi sau Caddy, nên `REMOTE_ADDR` của MỌI request là
# `127.0.0.1` — để False trên prod thì cả thế giới dùng chung một khoá đếm và người thứ
# sáu trong ngày bị chặn oan. Xem `core/han_muc.py::dia_chi_ip`.
TIN_X_FORWARDED_FOR=False
#
# URL NỘI BỘ của cửa nhận. Cố ý KHÔNG nằm dưới `/api/`: cả `next.config.ts` (dev) lẫn
# Caddy (prod) route `/api/*` sang Django, nên `/api/revalidate` chạy ở dev rồi chết trên
# prod. Bỏ trống để dùng mặc định.
#REVALIDATE_URL=http://localhost:3000/lam-moi-cache

# --- Ảnh (Phase 5, PLAN 8.5) -------------------------------------------------
# Ảnh người dùng tải lên lưu thẳng xuống ĐĨA (không R2, không minio — user chốt
# 2026-08-23). Bỏ trống cả hai để dùng mặc định của `config/settings.py`:
#   MEDIA_ROOT    = api/media/
#   MEDIA_AN_ROOT = api/media-an/   (cạnh MEDIA_ROOT, KHÔNG nằm trong nó)
#
# **Trên VPS phải đặt cả hai, và đặt NGOÀI cây mã nguồn** — deploy bằng `git pull` /
# thay nguyên thư mục không được xoá mất ảnh của người dùng:
#   MEDIA_ROOT=/var/lib/gikky/media
#   MEDIA_AN_ROOT=/var/lib/gikky/media-an
#
# ⚠ `MEDIA_ROOT` ở đây phải khớp ĐÚNG dòng `root` trong khối `/media/*` của
# `deploy/Caddyfile`. Hai giá trị nằm ở hai file và **không có gì kiểm chúng khớp nhau**:
# lệch một chữ thì upload vẫn 201, hàng DB vẫn đúng, và mọi thẻ <img> gãy. Nợ có tên.
#
# ⚠ `MEDIA_AN_ROOT` **KHÔNG được nằm trong `MEDIA_ROOT`**. Nó là kho cách ly cho ảnh của
# mốc đã thành bia mộ / bị mod ẩn, và Caddy phục vụ mọi thứ dưới `MEDIA_ROOT` thẳng từ
# đĩa — đặt nó vào trong là phục vụ lại đúng những tấm vừa bị gỡ (xem `core/anh_luu.py`).
#MEDIA_ROOT=
#MEDIA_AN_ROOT=

# --- Tìm kiếm: Meilisearch (Phase 7, PLAN 8.5) -------------------------------
# **Cả hai để TRỐNG ⇒ tìm kiếm TẮT HẲN.** Đó là mặc định đúng: một clone sạch không đi
# gọi một service chưa ai cài, và `pytest` không phụ thuộc vào tiến trình nền nào. Trang
# `/tim-kiem` khi tắt sẽ nói ra bằng tiếng người, phần còn lại của site không ảnh hưởng.
#
# `MEILI_URL` phải là địa chỉ **NỘI BỘ**. Meilisearch bind `127.0.0.1:7700` và Caddy
# **không** proxy tới nó: luật che nội dung (mạch bị mod ẩn, bia mộ) sống ở Django, còn
# một khoá search nằm trong trình duyệt là một khoá phát lại được với bộ lọc tuỳ ý.
#
# `MEILI_KEY` phải là khoá **PHẠM VI HẸP** — tạo bằng `POST /keys` với
# `"indexes": ["mach"]`. **Đừng dán master key vào đây**: master key tạo được khoá khác,
# tức là quyền quản trị toàn cụm cho một tiến trình chỉ cần đọc/ghi một index.
#
# ⚠ **Đặt hai biến này xong thì phải chạy MỘT LẦN:**
#     node scripts/py.mjs reindex_tim_kiem --sach
# Không phải để lấp dữ liệu cũ (tuy nó làm luôn việc đó), mà để **áp cấu hình index**.
# Meilisearch tự tạo index khi nhận tài liệu đầu tiên, nên bỏ bước này thì tìm kiếm vẫn
# chạy — bằng cấu hình MẶC ĐỊNH: `searchableAttributes` không có thứ tự ưu tiên (tiêu đề
# xếp ngang thân mốc thứ bảy) và `typoTolerance` không được ghim (mã chứng khoán bắt đầu
# kéo nhiễu khi Meilisearch đổi mặc định). Hỏng theo kiểu **kết quả xấu dần**, không có gì
# báo. Chạy lại lệnh này bất cứ lúc nào cũng an toàn.
#
# Meilisearch **không cần sao lưu riêng** — xem `docs/sao-luu-phuc-hoi.md`.
MEILI_URL=
MEILI_KEY=

# --- Tài khoản đội ngũ (2026-08-24) ------------------------------------------
# Ba mật khẩu cho ba tài khoản dựng sẵn. `node scripts/py.mjs tao_tai_khoan_doi` đọc ba
# biến này rồi tạo/cập nhật tài khoản (idempotent, chạy lại bao nhiêu lần cũng được):
#
#   admin@vi-du.gikky.net              u/admin              superuser + staff
#   gikky-team-news@vi-du.gikky.net    u/gikky-team-news    đăng bài
#   gikky-team-member@vi-du.gikky.net  u/gikky-team-member  đăng bài
#
# ⚠ **Đăng nhập bằng EMAIL, không phải username** — form đăng nhập gửi `email` cho allauth
# (`apps/web/lib/tai-khoan.ts::dangNhap`). Gõ `admin` vào ô email sẽ ăn 400.
#
# Sinh một chuỗi: python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# ⚠ Đây là mật khẩu viết thẳng ra đĩa. `.env` nằm trong `.gitignore` nên nó không vào
# repo, nhưng nó KHÔNG phải cách giữ bí mật trên hệ thống nhiều người truy cập. Ba dòng
# dưới để TRỐNG trong file mẫu này — `tao_tai_khoan_doi` báo lỗi rõ ràng nếu thiếu, chứ
# không lặng lẽ đặt một mật khẩu đoán được.
GIKKY_ADMIN_PASSWORD=
GIKKY_TEAM_NEWS_PASSWORD=
GIKKY_TEAM_MEMBER_PASSWORD=

# Tên miền email của ba tài khoản trên. **Để TRỐNG ở máy dev** — mặc định là
# `vi-du.gikky.net`, và bộ e2e nhận diện tài khoản dựng sẵn theo đúng hậu tố `vi-du.`
# (`apps/web/e2e/dung-seed.ts`), nên đặt giá trị khác ở đây là làm chúng mù.
#
# Trên PROD user chốt 2026-08-25 dùng tên miền thật: GIKKY_TEAM_EMAIL_DOMAIN=gikky.net
# ⇒ đăng nhập bằng `admin@gikky.net`. Đổi giá trị rồi chạy lại `tao_tai_khoan_doi` là
# lệnh tự dời email sang tên miền mới và HẠ CỜ (không xoá) địa chỉ cũ.
#GIKKY_TEAM_EMAIL_DOMAIN=

# --- Đếm lượt xem (trang thống kê `/luot-xem` ở khu quản trị, 2026-08-27) ------
# Chiều gọi NGƯỢC với `REVALIDATE_SECRET`: middleware của `apps/web` gọi
# `POST /api/v1/dem-luot-xem` mỗi lần có ai mở một trang công khai.
#
# **Bỏ trống ⇒ cửa TẮT HẲN (503) và KHÔNG ghi hàng nào** — cùng khuôn fail-closed với
# `REVALIDATE_SECRET`, và cùng lý do: endpoint này ghi DB mà không có phiên đăng nhập,
# nên để trần là ai cũng bơm số liệu rác vào trang thống kê bằng một vòng `curl`.
#
# ⚠ `pnpm setup:env` **KHÔNG** sinh sẵn chuỗi cho dòng này (khác `REVALIDATE_SECRET`):
# tắt là mặc định ĐÚNG ở máy dev — không ai cần thống kê của chính mình bấm quanh, và
# một lượt gọi HTTP thêm trên mỗi trang là thứ không nên bật khi chưa ai xin.
#
# Bật thì đặt CÙNG MỘT CHUỖI ở đây và ở tiến trình Next (`scripts/web-dev.mjs` đọc chính
# file này và chuyển tiếp sang `next dev`). Lệch nhau ⇒ 401, không ai đỏ, số đứng yên.
# Sinh tay: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEM_LUOT_XEM_SECRET=

# Dữ liệu THÔ giữ 90 ngày; tổng theo ngày giữ mãi. Cả hai việc do một lệnh làm, chạy
# hằng ngày (cron/systemd timer trên VPS) — chạy lại bao nhiêu lần cũng ra cùng kết quả:
#   node scripts/py.mjs gom_luot_xem
