# Chép thành `api/.env` rồi sửa: `pnpm setup:env` ở gốc repo làm đúng việc đó
# (không đè nếu `.env` đã có). File `.env` KHÔNG commit.

# `pnpm setup:env` THAY dòng dưới bằng một khoá ngẫu nhiên khi tạo `api/.env` — giá trị
# viết ở đây chỉ là chỗ giữ chỗ và KHÔNG BAO GIỜ được chạy trên máy nào: nó nằm trong repo,
# ai cũng đọc được, mà từ Phase 2 nó là khoá ký session cookie (giả mạo phiên được).
# Chép tay (không qua setup:env) thì tự sinh khoá:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=doi-chuoi-nay-o-moi-may-va-o-prod

# CHỈ CHO DEV. Lên prod phải là False: DEBUG=True in traceback kèm cấu hình ra trang lỗi,
# và nó cũng là công tắc mở `/api/v1/docs` + `/api/v1/openapi.json` (xem api/api/v1.py).
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Host được phép chạm `/api/admin/*` — hàng rào tầng hạ tầng của PLAN 8.2, mô phỏng bằng
# middleware `config/host_admin.py`. Bỏ trống dòng này để dùng mặc định của dev (xem
# `config/settings.py`); trên prod đặt đúng MỘT host: ADMIN_HOSTS=admin.gikky.net
#
# ⚠ Ở DEV nó KHÔNG tách được app admin (3001) khỏi app public (3000): cả hai rewrite
# `/api/*` sang cùng một origin nên Django thấy cùng một Host. Lớp che thật ở dev là
# permission `is_staff`. Đọc docstring `config/host_admin.py` trước khi tin dòng này.
#ADMIN_HOSTS=admin.gikky.net
#
# Cookie/CSRF cross-subdomain mà khu quản trị cũng cần nằm ở khối "CSRF / cookie" CUỐI
# file — khai đúng một lần. Thêm một dòng `SESSION_COOKIE_DOMAIN=` thứ hai ở đây thì
# django-environ đọc file từ trên xuống và **dòng dưới thắng**, im lặng.

# Máy dev hiện tại: PostgreSQL 17 LOCAL ở cổng 5432 (không dùng Docker).
# Nếu chạy docker-compose.dev.yml thì đổi cổng sang 55432 — xem docker-compose.dev.yml.
#
# `setup:env` KHÔNG sinh mật khẩu hộ (khác `SECRET_KEY`) — nó không biết bạn đã tạo role
# `gikky` bằng mật khẩu gì. Sửa tay dòng dưới cho khớp `CREATE ROLE gikky LOGIN PASSWORD …`.
# File này nằm trong repo công khai ⇒ KHÔNG được mang một mật khẩu thật của bất kỳ máy nào.
DATABASE_URL=postgres://gikky:doi-mat-khau-nay@127.0.0.1:5432/gikky_dev

# --- Tài khoản (Phase 2) -----------------------------------------------------
# Gốc của frontend Next công khai. Link trong email xác thực / đặt lại mật khẩu trỏ về
# đây, và nó PHẢI tuyệt đối: request tới Django ở dev đi qua rewrites của Next nên Host
# của nó là localhost:8000 — link tương đối sẽ ra đúng cổng Django và người bấm nhận 404.
#
# Cũng là origin mà digest tuần của Phase 6 dựng link (`gui_digest.py::goc_site`), nên nó
# phải KHỚP biến `SITE_ORIGIN` của `apps/web` (`apps/web/lib/site.ts`). Hai tên cho một
# giá trị là dấu vết của hai mảng làm song song; lượt gộp 2026-08-23 giữ tên này ở phía
# Django và không khai `SITE_ORIGIN` thứ hai.
FRONTEND_ORIGIN=http://localhost:3000

# Google OAuth: KHÔNG có credential thì provider không được đăng ký và frontend KHÔNG
# render nút (PLAN mục 4 — cấm nút vĩnh viễn không bấm được). Để trống là trạng thái
# đúng của máy dev.
# Redirect URI phải đăng ký với Google (bản headless):
#   https://gikky.net/api/_allauth/browser/v1/auth/provider/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Bỏ trống => ghi ra file `api/.mail/` (dev, không cần SMTP). Prod đặt SMTP:
#   EMAIL_URL=smtp://user:mat-khau@smtp.example.com:587/?tls=True
EMAIL_URL=
DEFAULT_FROM_EMAIL=gikky <khong-tra-loi@gikky.net>

# CSRF / cookie (PLAN 8.2). Bỏ trống => mặc định 4 origin dev (localhost + 127.0.0.1,
# cổng 3000 và 3001). Prod:
#   CSRF_TRUSTED_ORIGINS=https://gikky.net,https://admin.gikky.net
#   SESSION_COOKIE_DOMAIN=.gikky.net
#   CSRF_COOKIE_DOMAIN=.gikky.net
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# --- On-demand revalidate (Phase 3, PLAN 8.4 điểm 3) -------------------------
# Django gọi ngược Next để làm mới trang mạch đã cache khi có sự kiện CÓ signal (mốc
# mới, trích, đóng/mở/khoá mạch). Cơ chế: `api/core/revalidate.py`.
#
# **Bỏ trống `REVALIDATE_SECRET` là TẮT HẲN, và đó là mặc định đúng ở máy dev**: một lời
# gọi HTTP ra localhost:3000 giữa lúc chạy `pnpm test` sẽ hoặc treo tới timeout, hoặc đập
# vào app Next của người khác đang chạy.
#
# Bật thì đặt CÙNG MỘT chuỗi ở đây và ở biến `REVALIDATE_SECRET` của tiến trình Next
# (`apps/web`) — hai bên lệch nhau thì cửa nhận trả 401 và cache lặng lẽ không bao giờ
# được làm mới. Sinh khoá: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
REVALIDATE_SECRET=
#
# URL NỘI BỘ của cửa nhận. Cố ý KHÔNG nằm dưới `/api/`: cả `next.config.ts` (dev) lẫn
# Caddy (prod) route `/api/*` sang Django, nên `/api/revalidate` chạy ở dev rồi chết trên
# prod. Bỏ trống để dùng mặc định.
#REVALIDATE_URL=http://localhost:3000/lam-moi-cache

# --- Ảnh (Phase 5, PLAN 8.5) -------------------------------------------------
# Ảnh người dùng tải lên lưu thẳng xuống ĐĨA (không R2, không minio — user chốt
# 2026-08-23). Bỏ trống cả hai để dùng mặc định của `config/settings.py`:
#   MEDIA_ROOT    = api/media/
#   MEDIA_AN_ROOT = api/media-an/   (cạnh MEDIA_ROOT, KHÔNG nằm trong nó)
#
# **Trên VPS phải đặt cả hai, và đặt NGOÀI cây mã nguồn** — deploy bằng `git pull` /
# thay nguyên thư mục không được xoá mất ảnh của người dùng:
#   MEDIA_ROOT=/var/lib/gikky/media
#   MEDIA_AN_ROOT=/var/lib/gikky/media-an
#
# ⚠ `MEDIA_ROOT` ở đây phải khớp ĐÚNG dòng `root` trong khối `/media/*` của
# `deploy/Caddyfile`. Hai giá trị nằm ở hai file và **không có gì kiểm chúng khớp nhau**:
# lệch một chữ thì upload vẫn 201, hàng DB vẫn đúng, và mọi thẻ <img> gãy. Nợ có tên.
#
# ⚠ `MEDIA_AN_ROOT` **KHÔNG được nằm trong `MEDIA_ROOT`**. Nó là kho cách ly cho ảnh của
# mốc đã thành bia mộ / bị mod ẩn, và Caddy phục vụ mọi thứ dưới `MEDIA_ROOT` thẳng từ
# đĩa — đặt nó vào trong là phục vụ lại đúng những tấm vừa bị gỡ (xem `core/anh_luu.py`).
#MEDIA_ROOT=
#MEDIA_AN_ROOT=
