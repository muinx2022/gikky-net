# Mẫu file env cho stack prod. Trên VPS nó nằm ở `~/gikky-net/app/.env` — **NGOÀI cây mã
# nguồn**, vì `~/gikky-net/src` bị rsync đè mỗi lần deploy.
#
#   docker compose -f deploy/prod/compose.yml --env-file ~/gikky-net/app/.env up -d --build
#
# File này KHÔNG phải `api/.env`. Django trong container không đọc file nào cả: nó đọc
# **biến môi trường** do `compose.yml` truyền vào (`environ.Env.read_env` không tìm thấy
# `api/.env` — `.dockerignore` loại nó — nên django-environ rơi về `os.environ`).
#
# Sinh một chuỗi ngẫu nhiên: `openssl rand -base64 36 | tr -d '/+=' | cut -c1-40`

# --- Bắt buộc: thiếu cái nào compose DỪNG kèm thông báo (`${VAR:?...}`) ------
SECRET_KEY=
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
# Django và container `web` phải cùng MỘT chuỗi này.
REVALIDATE_SECRET=

# --- Có mặc định ------------------------------------------------------------
SITE_ORIGIN=https://gikky.net

# Khoá Meilisearch PHẠM VI HẸP (chỉ index `mach`). Sinh bằng:
#   deploy/prod/tao-khoa-meili.sh
# Để trống ⇒ tìm kiếm TẮT HẲN (trang /tim-kiem nói ra bằng tiếng người, phần còn lại của
# site không ảnh hưởng). **Đừng dán master key vào đây** — nó tạo được khoá khác.
MEILI_KEY=

# ⚠ Để TRỐNG là site KHÔNG ĐĂNG KÝ ĐƯỢC: `ACCOUNT_EMAIL_VERIFICATION = "mandatory"`, nên
# không có SMTP thì mail xác thực rơi vào một file bên trong container và người đăng ký
# đứng vĩnh viễn ở trạng thái chưa xác thực. Đặt xong thì `docker compose up -d api`.
#   EMAIL_URL=smtp://user:mat-khau@smtp.example.com:587/?tls=True
EMAIL_URL=
DEFAULT_FROM_EMAIL=gikky <khong-tra-loi@gikky.net>

# Trống ⇒ provider Google không được đăng ký và frontend KHÔNG render nút (PLAN mục 4).
# Redirect URI phải đăng ký với Google (bản headless):
#   https://gikky.net/api/_allauth/browser/v1/auth/provider/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ba tài khoản đội ngũ ----------------------------------------------------
# `docker compose exec api python manage.py tao_tai_khoan_doi` đọc ba biến này.
# Idempotent — chạy lại bao nhiêu lần cũng được.
GIKKY_ADMIN_PASSWORD=
GIKKY_TEAM_NEWS_PASSWORD=
GIKKY_TEAM_MEMBER_PASSWORD=

# Tên miền email của ba tài khoản trên. Mặc định của lệnh là `vi-du.gikky.net` (tên miền
# dữ liệu dựng sẵn); **prod đặt tên miền THẬT** — user chốt 2026-08-25:
GIKKY_TEAM_EMAIL_DOMAIN=gikky.net
# ⇒ đăng nhập bằng `admin@gikky.net` / `gikky-team-news@gikky.net` /
#   `gikky-team-member@gikky.net` (gikky đăng nhập bằng EMAIL, không phải username).
#
# Đổi giá trị rồi chạy lại `tao_tai_khoan_doi`: lệnh tự dời email sang tên miền mới và
# HẠ CỜ `primary` của địa chỉ cũ — không xoá, vì một lệnh dựng dữ liệu không có quyền
# vứt đi một địa chỉ có thể là email thật của người đang dùng tài khoản.
#
# ⚠ Biết trước khi bật SMTP: `admin@gikky.net` khi đó là địa chỉ THẬT. Hoặc nó có hộp thư
# thật (thư đặt lại mật khẩu đi vào đó — tốt), hoặc nó không tồn tại và mọi thư gửi tới
# nó **bounce** trong khi allauth vẫn báo "đã gửi".
