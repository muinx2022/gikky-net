{
  "expo": {
    "name": "gikky",
    "slug": "gikky",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gikky",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.gikky.app"
    },
    "android": {
      "package": "net.gikky.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
