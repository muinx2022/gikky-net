  "paths": {
    "/api/v1/feeds/dang-dien-ra": {
      "get": {
        "description": "Feed **Đang diễn ra**: mạch còn mở, mốc mới nhất trước (`last_entry_at` giảm dần).\n\nFeed đặc sản của gikky, **không phải** Hot: mốc mới không \"bump\" bài, nó chỉ cập nhật\nkhoá sort của riêng feed này.\n\n`last_entry_at` đo **cấu trúc** — mọi mốc đều tính, kể cả mốc bị mod ẩn. Vì thế một\nmạch có thể đứng đầu feed này mà mở ra là **mặt CẶN** (`face` tính theo\n`last_activity_at`, vốn chỉ đo nội dung đọc được). Đó là hành vi đúng theo luật đếm\nhiện hành, đã ghi ở PLAN mục 6 \"hệ quả cố ý 2\" — đừng chữa bằng cách đổi khoá sort.\n\nTham số như `GET /feeds/moi`.",
        "operationId": "liet_ke_feed_dang_dien_ra",
        "parameters": [
          {
            "in": "query",
            "name": "sub",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sub"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedOut"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoiOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoiOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Feed Dang Dien Ra",
        "tags": [
          "feed"
        ]
      }
    },
    "/api/v1/feeds/moi": {
      "get": {
        "description": "Feed **Mới**: mọi bài, mới đăng trước (`created_at` giảm dần).\n\n`?sub=<slug>` lọc theo chuyên mục; sub không tồn tại trả 404 `sub_khong_ton_tai`.\n`?cursor=` là cursor keyset lấy từ `cursor_ke_tiep` của trang trước; `null` là hết.\n`?limit=` tối đa 50.\n\nMạch bị mod ẩn không xuất hiện. Mạch đã đóng sổ **vẫn xuất hiện** — feed này sắp theo\nlúc bài ra đời, không theo trạng thái sổ.",
        "operationId": "liet_ke_feed_moi",
        "parameters": [
          {
            "in": "query",
            "name": "sub",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sub"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedOut"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoiOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoiOut"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Feed Moi",
        "tags": [
          "feed"
        ]
      }
